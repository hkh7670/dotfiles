#font-style-bold = Bold
#font-style-italic = Regular
#font-style-bold-italic = Bold
#font-family = Sarasa Term K Nerd Font
#font-family-bold = D2CodingLigature Nerd Font Mono Bold
#font-family = Sarasa Term Slab K Nerd Font
font-size = 16
font-thicken = true
font-thicken-strength = 100

## ligature 비활성화
font-feature = -calt, -liga, -dlig

## line height 설정
adjust-cell-height = 20%

# 윈도우 패딩 (좌/우)
window-padding-x = 10,10

# 윈도우 패딩 (상/하)
window-padding-y = 10,10

# cursor
#cursor-style = underline
#cursor-style-blink = true

# clipboard
# copy-on-select = clipboard
# clipboard-trim-trailing-spaces = true

# # mouse
# mouse-scroll-multiplier = 2
# mouse-hide-while-typing = true

# window
# initial-window = true
# resize-overlay = never
# background-opacity = 0.95
# background-blur-radius = 10
# window-save-state = always
# window-step-resize = false
# window-padding-balance = true
# confirm-close-surface = false

# # behavior
# auto-update = off
# # auto-update-channel = stable
# quit-after-last-window-closed = true
# shell-integration-features = true

# macos
macos-option-as-alt = true
# macos-titlebar-style = transparent

# ⌥⌫ : 뒤 단어 삭제 (readline: backward-kill-word = ESC + DEL)
#keybind = opt+backspace=text:\x1b\x7f

# ⌥⌦ : 앞 단어 삭제 (readline: kill-word = ESC + 'd')
keybind = opt+delete=esc:d

# ⌘⌫ : 커서 왼쪽 전부 삭제 (readline: Ctrl-U)
#keybind = cmd+backspace=text:\x15

# ⌘⌦ : 커서부터 줄 끝까지 삭제 (readline: Ctrl-K)
keybind = cmd+delete=text:\x0b

# Cmd+Option+Left/Right 로 탭 전환
keybind = cmd+option+left=previous_tab
keybind = cmd+option+right=next_tab

# 스크롤백 용량 (바이트 단위)
# 100MB
scrollback-limit = 100000000

# 클립보드: 뒤 공백 제거 (존재하는 키)
# clipboard-trim-trailing-spaces = true

# 마지막 창 닫으면 앱 종료 (정상 옵션)
# quit-after-last-window-closed = true

desktop-notifications = true

