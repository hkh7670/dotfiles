# ~/.config/ghostty/config
# ════════════════════════════════════════════════════════════

# ── 테마 ────────────────────────────────────────────────────
theme = Catppuccin Macchiato

# ── 폰트 ────────────────────────────────────────────────────
font-family = Sarasa Term Slab K
font-size = 16
font-thicken = true

# ligature 비활성화
font-feature = -calt, -liga, -dlig

# line height 조정
adjust-cell-height = 20%

# ── 윈도우 ──────────────────────────────────────────────────
# 좌/우 패딩
window-padding-x = 10,10
# 상/하 패딩
window-padding-y = 10,10

# ── macOS ───────────────────────────────────────────────────
macos-option-as-alt = true

# ── 키 바인딩: 커서 이동 / 텍스트 삭제 ─────────────────────────
# ⌥⌫ : 뒤 단어 삭제 (readline: backward-kill-word = ESC + DEL)
#keybind = opt+backspace=text:\x1b\x7f

# ⌥⌦ : 앞 단어 삭제 (readline: kill-word = ESC + 'd')
keybind = opt+delete=esc:d

# ⌘⌫ : 커서 왼쪽 전부 삭제 (readline: Ctrl-U)
#keybind = cmd+backspace=text:\x15

# ⌘⌦ : 커서부터 줄 끝까지 삭제 (readline: Ctrl-K)
keybind = cmd+delete=text:\x0b

# ⌘←/→ : 줄 처음/끝으로 이동
# 기본값은 Ctrl-A/Ctrl-E(readline)인데, tmux prefix를 C-a로 바꿔놔서
# tmux 안에서는 Ctrl-A가 prefix로 먹혀버림 → Home/End 시퀀스로 대체해 충돌 회피
keybind = cmd+left=text:\x1b[H
keybind = cmd+right=text:\x1b[F

# ── 키 바인딩: 탭 전환 ─────────────────────────────────────────
# ⌘⌥←/→ : 이전/다음 탭
keybind = cmd+option+left=previous_tab
keybind = cmd+option+right=next_tab

# ── 기타 ────────────────────────────────────────────────────
# 스크롤백 용량 (100MB, 바이트 단위)
scrollback-limit = 100000000
