# ~/.zshrc
# ════════════════════════════════════════════════════════════

# ── oh-my-zsh ────────────────────────────────────────────────
ZSH_THEME="" # Starship이 프롬프트를 관리하므로 비워둠
export ZSH="$HOME/.oh-my-zsh"
# fzf는 아래쪽 `source <(fzf --zsh)`로 초기화하므로 여기에 넣지 않는다 (넣으면 키바인딩 이중 등록)
# zsh-syntax-highlighting은 다른 플러그인이 등록한 ZLE 위젯을 감싸야 하므로 반드시 마지막
plugins=(
  docker
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# Homebrew 공식 shellenv 설정 (PATH/FPATH/MANPATH 등) - compinit 실행 전에 있어야 함
eval "$(/opt/homebrew/bin/brew shellenv)"
fpath+=${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src
source $HOME/.catppuccin-zsh-syntax-highlighting.zsh

# Fzf Theme (Catppuccin Mocha)
export FZF_DEFAULT_OPTS=" \
--color=bg+:#313244,bg:#1E1E2E,spinner:#F5E0DC,hl:#F38BA8 \
--color=fg:#CDD6F4,header:#F38BA8,info:#CBA6F7,pointer:#F5E0DC \
--color=marker:#B4BEFE,fg+:#CDD6F4,prompt:#CBA6F7,hl+:#F38BA8 \
--color=selected-bg:#45475A \
--color=border:#6C7086,label:#CDD6F4"

source $ZSH/oh-my-zsh.sh # compinit 실행 시점

# ── 키 바인딩: Home/End (Ghostty의 cmd+←/→ 대응) ─────────────
# Ghostty가 cmd+←/→ 로 \e[H, \e[F 를 보내는데, 현재 terminfo의 khome/kend는
# 다른 시퀀스(\eOH, \eOF)라 zsh가 기본적으로 인식하지 못해 명시적으로 바인딩
bindkey "\e[H" beginning-of-line
bindkey "\e[F" end-of-line
bindkey "\eOH" beginning-of-line
bindkey "\eOF" end-of-line

# ── PATH ────────────────────────────────────────────────────
# /opt/homebrew 관련 경로는 위쪽 brew shellenv에서 이미 설정됨
# typeset -U path 로 중복 경로는 자동 제거됨
typeset -U path
export PATH="$HOME/.local/bin:$PATH"
export XDG_CONFIG_HOME="$HOME/.config" # Change Lazygit Config Path

# ── 에디터 ──────────────────────────────────────────────────
alias vim="nvim"
alias vi="nvim"
alias vimdiff="nvim -d"
export EDITOR="/opt/homebrew/bin/nvim"

# ── 편의 alias ──────────────────────────────────────────────
alias ll="ls -alhF"
alias ta="tmux attach -t"

# ── 프롬프트 / 셸 도구 활성화 ─────────────────────────────────
# oh-my-zsh 이후에 로드해야 테마가 덮어쓰이지 않음
eval "$(starship init zsh)"
eval "$(mise activate zsh)"
source <(fzf --zsh)

# ── SSH 터널링 alias ────────────────────────────────────────
if [ -f "$HOME/.ssh-tunneling-alias" ]; then
    source "$HOME/.ssh-tunneling-alias"
fi

# ── AWS 프로필 전환 ─────────────────────────────────────────
# 현재 세션에만 적용
function awsuse() {
  export AWS_PROFILE=$1
  echo "✅ AWS profile switched to: $1"
  aws sts get-caller-identity
}

# 현재 프로필 확인
function awswho() {
  echo "Current profile: ${AWS_PROFILE:-default}"
  aws sts get-caller-identity
}

# 프로필 자동완성
function _awsuse() {
  local -a profiles
  profiles=("${(@f)$(aws configure list-profiles 2>/dev/null)}")
  compadd -a profiles
}
compdef _awsuse awsuse

# ── 프로젝트별 alias ────────────────────────────────────────
# 백엔드 빌드파일 원격 Copy
alias scp-spring-boot-jar="scp $HOME/workspace/spring-boot-kotlin-practice/build/libs/spring-boot-kotlin-practice.jar mac-mini:docker/spring-boot/app.jar"
